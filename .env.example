# Database
POSTGRES_DB=attendance
POSTGRES_USER=att
POSTGRES_PASSWORD=change_me_strong_password

# Auth
JWT_SECRET=change_me_jwt_secret_min_32_chars
REFRESH_TOKEN_SECRET=change_me_refresh_secret_min_32_chars

# Default geofence (used if company_settings table is empty)
COMPANY_LAT=37.5665
COMPANY_LNG=126.9780
COMPANY_RADIUS_METERS=200

# FCM (Firebase Cloud Messaging) — optional
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email reports — optional
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=smtp_password
# HR_EMAIL=hr@example.com
