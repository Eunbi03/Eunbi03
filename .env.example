# ===== 데이터베이스 =====
DB_NAME=attendance
DB_USER=att
DB_PASSWORD=change_me_strong_password
# (api 컨테이너는 DB_HOST=db 를 docker-compose 에서 자동 주입받습니다.
#  로컬에서 직접 실행할 때만 아래 두 줄의 주석을 푸세요.)
# DB_HOST=localhost
# DB_PORT=5432

# ===== 인증 =====
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=90

# ===== 최초 관리자 계정 (서버 첫 기동 시 1회 생성) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=시스템관리자

# ===== 기본 지오펜스 (company_settings 테이블이 비어있을 때 사용) =====
COMPANY_LAT=37.5665
COMPANY_LNG=126.9780
COMPANY_RADIUS_METERS=200

# ===== FCM (Firebase Cloud Messaging) — 선택 =====
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ===== 이메일 리포트 — 선택 =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=smtp_password
# HR_EMAIL=hr@example.com
